{
  "atomCode": "cmake-build",
  "name": "CMake build",
  "version": "1.3.0",
  "description": "Configures with cmake, builds a target and optionally installs it into a prefix, the same shape as the maven and gradle atoms.",
  "execution": {
    "packagePath": "cmake-build.jar",
    "language": "java",
    "target": "$atom_java_path -cp cmake-build.jar com.jenkinschina.atom.sdk.AtomRunner"
  },
  "input": {
    "source": {
      "label": "源码目录",
      "type": "vuex-input",
      "default": "."
    },
    "buildDir": {
      "label": "构建目录",
      "type": "vuex-input",
      "default": "build"
    },
    "generator": {
      "label": "生成器（如 Ninja）",
      "type": "vuex-input",
      "default": ""
    },
    "preloadScript": {
      "label": "预载脚本 -C（相对工作区，插件的 Preload Script）",
      "type": "vuex-input",
      "default": ""
    },
    "buildType": {
      "label": "构建类型",
      "type": "selector",
      "default": "Release",
      "options": [
        "Release",
        "Debug",
        "RelWithDebInfo",
        "MinSizeRel"
      ]
    },
    "target": {
      "label": "目标（留空 = all）",
      "type": "vuex-input",
      "default": ""
    },
    "configureArgs": {
      "label": "configure 额外参数",
      "type": "vuex-input",
      "default": ""
    },
    "buildArgs": {
      "label": "build 额外参数",
      "type": "vuex-input",
      "default": ""
    },
    "jobs": {
      "label": "并行度（0 = 工具默认）",
      "type": "vuex-input-number",
      "default": "0"
    },
    "clean": {
      "label": "先删构建目录",
      "type": "checkbox",
      "default": "false"
    },
    "cleanInstallDir": {
      "label": "先清空安装目录（插件里的 Wipeout Install Dir）",
      "type": "checkbox",
      "default": "false"
    },
    "runTests": {
      "label": "构建后跑 ctest",
      "type": "checkbox",
      "default": "false"
    },
    "testArgs": {
      "label": "ctest 额外参数（如 --output-junit reports/ctest.xml）",
      "type": "vuex-input",
      "default": ""
    },
    "failOnTestFailure": {
      "label": "有测试失败就让这一步失败",
      "type": "checkbox",
      "default": "true"
    },
    "outputJunit": {
      "label": "同时写出 JUnit 报告（留空则只看 testArgs）",
      "type": "vuex-input",
      "default": ""
    },
    "installDir": {
      "label": "安装目录（相对工作区，留空则只构建不安装）",
      "type": "vuex-input",
      "default": ""
    },
    "installCommand": {
      "label": "安装命令（在构建目录里执行，留空则 cmake --install）",
      "type": "vuex-input",
      "default": ""
    }
  },
  "output": {
    "buildDir": {
      "type": "string",
      "description": "构建目录"
    },
    "buildType": {
      "type": "string",
      "description": "构建类型"
    },
    "binaries": {
      "type": "string",
      "description": "产物数"
    },
    "build": {
      "type": "artifact",
      "description": "归档的构建目录"
    },
    "testsPassed": {
      "type": "string",
      "description": "通过的测试数"
    },
    "testsFailed": {
      "type": "string",
      "description": "失败的测试数"
    },
    "junitReport": {
      "type": "string",
      "description": "JUnit 报告的完整路径"
    },
    "installDir": {
      "type": "string",
      "description": "安装目录（未安装时为空）"
    },
    "installedFiles": {
      "type": "string",
      "description": "安装到安装目录的文件数"
    },
    "install": {
      "type": "artifact",
      "description": "归档的安装目录（仅在设置了安装目录时）"
    }
  },
  "x-jenkins": {
    "protocol": "jenkins-1",
    "requires": {
      "runner": ">=0.4.0"
    }
  }
}
